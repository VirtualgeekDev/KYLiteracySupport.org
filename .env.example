# Kentucky Literacy Foundation, Inc. - Environment Variables
# Domain: KYLiteracySupport.org

# 1. Donation Platform
# When ready, set to your verified donation processor (e.g., Donorbox, Givebutter, Stripe Payment Link)
NEXT_PUBLIC_DONATION_URL=""

# 2. Contact Form & Email Delivery
# Where contact form submissions should be delivered
CONTACT_EMAIL="info@kyliteracysupport.org"
NEXT_PUBLIC_CONTACT_EMAIL="info@kyliteracysupport.org"

# Email Provider API Key (e.g., Resend, SendGrid, Formspree)
# Leave blank for default console-logging mock mode
EMAIL_API_KEY=""

# 3. Analytics (Optional & Privacy-Conscious)
# If enabled later, update Privacy Policy accordingly
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
