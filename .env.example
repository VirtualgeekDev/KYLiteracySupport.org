# =============================================================================
# Kentucky Literacy Foundation, Inc. - Environment Configuration
# Domain: KYLiteracySupport.org
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Stripe Payment Gateway (TEST MODE & PRODUCTION MODE)
# -----------------------------------------------------------------------------
# For testing: Obtain test keys from your Stripe Dashboard (Developers > API Keys)
# Format: sk_test_... and pk_test_...
# When ready for live payments: Replace with sk_live_... and pk_live_...
STRIPE_SECRET_KEY="sk_test_replace_with_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_replace_with_your_stripe_publishable_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_with_your_stripe_publishable_key"

# Stripe Webhook Secret
# Obtain from: Stripe Dashboard > Developers > Webhooks (endpoint: https://KYLiteracySupport.org/api/webhooks/stripe)
# For local testing with Stripe CLI:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_replace_with_your_webhook_signing_secret"

# -----------------------------------------------------------------------------
# 2. Hidden Admin Panel Authentication (/admin/donations)
# -----------------------------------------------------------------------------
# Default administrator login credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="AdminKY2026!Literacy"

# Optional: Pre-hashed password salt
ADMIN_PASSWORD_SALT="ky_literacy_secure_salt_2026"

# -----------------------------------------------------------------------------
# 3. Notification & Contact Email Settings
# -----------------------------------------------------------------------------
# Where offline donation requests and contact inquiries are delivered
CONTACT_EMAIL="info@kyliteracysupport.org"
ADMIN_EMAIL="info@kyliteracysupport.org"
NEXT_PUBLIC_CONTACT_EMAIL="info@kyliteracysupport.org"

# Optional: Email Service Provider API Key (e.g. Resend, SendGrid)
# If left empty, notifications log clearly to the server console.
RESEND_API_KEY=""

# -----------------------------------------------------------------------------
# 4. Optional Privacy-Conscious Analytics
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
